menu "MKAuto telemetria simulada"

    config MK_TELEMETRY_SIM
        bool "Usar telemetria simulada"
        default y
        help
            Publica um ciclo de conducao sintetico no modelo de telemetria,
            para desenvolver a interface sem ELM/BLE (DEC-012). Desligar
            quando a fonte real do veiculo estiver integrada.

    config MK_TELEMETRY_SIM_DROPOUTS
        bool "Simular perdas de comunicacao"
        depends on MK_TELEMETRY_SIM
        default y
        help
            A cada 90 s para de publicar por 3 s, exercitando os estados
            STALE e indisponivel na interface.

endmenu
